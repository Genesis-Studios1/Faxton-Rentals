// Firebase Storage holds public property listing photos/videos and optional app installers.
// Chat attachments and personal documents remain in Firestore documents under their own size-limited rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPrivileged() {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let ownerPath = /databases/(default)/documents/config/owner;
      return request.auth != null
        && ((firestore.exists(ownerPath) && firestore.get(ownerPath).data.get('uid', '') == request.auth.uid)
          || (firestore.exists(userPath) && firestore.get(userPath).data.get('role', '') == 'admin'));
    }

    // Uploaders may manage media in their own UID folder. Landlords can list immediately;
    // agents and agencies need the same verified status required by Firestore listing creation.
    // The owner/admin can manage media for any UID folder so they can moderate existing listings.
    function canUploadOwnListingMedia(uid) {
      let userPath = /databases/(default)/documents/users/$(uid);
      return request.auth != null
        && request.auth.uid == uid
        && firestore.exists(userPath)
        && (isPrivileged()
          || firestore.get(userPath).data.get('role', '') == 'landlord'
          || (firestore.get(userPath).data.get('role', '') in ['agent', 'agency']
            && firestore.get(userPath).data.get('verified', false) == true));
    }

    // Installer files are public downloads (they contain no secrets). Only admins can upload or remove them.
    match /installers/{version}/{file} {
      allow read: if true;
      allow write: if isPrivileged() && request.resource.size < 600 * 1024 * 1024;
      allow delete: if isPrivileged();
    }

    // Public listing media. New uploads are size- and MIME-checked; files cannot be overwritten in place.
    match /listing-media/{uid}/{listingId}/{kind}/{file} {
      allow read: if true;
      allow create: if canUploadOwnListingMedia(uid)
        && (
          (kind == 'images'
            && request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)'))
          ||
          (kind == 'videos'
            && request.resource.size <= 100 * 1024 * 1024
            && request.resource.contentType.matches('video/(mp4|webm|quicktime)'))
        );
      allow update: if false;
      allow delete: if canUploadOwnListingMedia(uid) || isPrivileged();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
