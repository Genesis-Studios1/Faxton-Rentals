// Private KYC files and property-ownership evidence. Public listing photos remain existing https links.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && ((firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
              && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
            || (firestore.exists(/databases/(default)/documents/config/owner)
              && firestore.get(/databases/(default)/documents/config/owner).data.uid == request.auth.uid));
    }
    function permittedDocument() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
    }

    // Users can upload their own identity/address/business evidence. Only the owner of the account and authorised staff can read it.
    match /verificationDocs/{uid}/{kind}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid
        && kind in ['governmentId', 'proofOfAddress', 'ownershipProof', 'cacCertificate', 'professionalRegistration']
        && permittedDocument();
      allow update: if false;
      allow delete: if admin();
    }

    // Ownership evidence is private to the submitting property owner and authorised reviewers.
    match /listingOwnership/{uid}/{listingId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid && permittedDocument();
      allow update: if false;
      allow delete: if admin();
    }

    // Installer files are public downloads; only admins can upload or remove them.
    match /installers/{version}/{file} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 600 * 1024 * 1024;
      allow delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
