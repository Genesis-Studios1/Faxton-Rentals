// Verification documents are private. Never expose ID/ownership documents through public download URLs.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/config/owner).data.uid == request.auth.uid);
    }

    // IDs, proof of address and property-ownership documents are private to the owner and authorized reviewers.
    match /verification/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    // Installer files are public downloads; only admins can upload or remove them.
    match /installers/{version}/{file} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 600 * 1024 * 1024;
      allow delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
