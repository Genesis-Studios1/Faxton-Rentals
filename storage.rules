// Faxton keeps pictures, audio and documents inside Firestore documents (as data), so the app does NOT use Firebase Storage.
// The only exception is the optional app-installer upload in Admin > Installations, which needs Storage (and the paid Blaze plan).
// Everything else is closed. If you never switch Storage on, this file does nothing.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      let o = firestore.get(/databases/(default)/documents/config/owner);
      return request.auth != null && (u.data.role == 'admin' || o.data.uid == request.auth.uid);
    }
    // Installer files are public downloads (they contain no secrets). Only admins can upload or remove them.
    match /installers/{version}/{file} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 600 * 1024 * 1024;
      allow delete: if admin();
    }
    // Property photos and videos are public listing media. Only signed-in Faxton staff
    // can upload them through the listing manager; files are stored outside Firestore.
    match /listing-media/{uid}/{listingId}/{kind}/{file} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && admin()
        && (
          (kind == 'images'
            && request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)'))
          ||
          (kind == 'videos'
            && request.resource.size <= 100 * 1024 * 1024
            && request.resource.contentType.matches('video/(mp4|webm|quicktime)'))
        );
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid && admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
