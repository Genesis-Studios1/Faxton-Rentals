// Private identity, address and ownership documents are never public and are not stored as Firestore data URLs.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }
    function isAdmin() {
      return signedIn() && (
        userDoc(request.auth.uid).data.get('role', '') == 'admin'
        || (firestore.exists(/databases/(default)/documents/config/owner)
          && firestore.get(/databases/(default)/documents/config/owner).data.get('uid', '') == request.auth.uid)
      );
    }
    function maySubmitVerification(uid) {
      return signedIn() && request.auth.uid == uid
        && userDoc(uid).data.get('role', '') in ['agent', 'landlord']
        && userDoc(uid).data.get('onboarding', {}).get('completed', false) == false
        && userDoc(uid).data.get('verification', {}).get('status', 'pending') == 'pending';
    }

    // Government ID, proof of address, and landlord ownership documents are private review material.
    // Only the account owner can upload while completing onboarding. The owner and authorised reviewers can read.
    match /verification/{uid}/{documentName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if maySubmitVerification(uid)
        && documentName in ['identity', 'address-proof', 'ownership-proof']
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
      allow delete: if (maySubmitVerification(uid)
          || (signedIn() && request.auth.uid == uid && userDoc(uid).data.get('deletion', {}).get('status', '') == 'approved'))
        && documentName in ['identity', 'address-proof', 'ownership-proof'];
    }

    // Installer files are public downloads (they contain no personal documents). Only admins can upload or remove them.
    match /installers/{version}/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 600 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
