rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function db() { return /databases/$(database)/documents; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    // The single owner is whoever config/owner points at. Only the owner can transfer it.
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function isAdmin() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'renter') : '';
    }
    function isSupport() { return myRole() == 'support'; }
    function isVerified() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true;
    }
    function ownsListing() { return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid; }
    function owns() { return signedIn() && resource.data.uid == request.auth.uid; }
    function short(v, n) { return v is string && v.size() <= n; }
    // Optional profile fields must have the right type and size.
    function profileOk(d) {
      return (!('phone' in d) || short(d.phone, 30))
        && (!('location' in d) || short(d.location, 80))
        && (!('photo' in d) || short(d.photo, 70000))
        && (!('prefs' in d) || d.prefs is map)
        && (!('notify' in d) || d.notify is map)
        && (!('privacy' in d) || d.privacy is map);
    }

    // Never readable or writable from the app. Set once from the Firebase console: { ownerEmail: "<owner's email>" }
    match /config/bootstrap { allow read, write: if false; }

    // Ownership is claimed once, by the verified email stored in config/bootstrap, then transferable only by the owner.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(ownerDoc())
        && exists(/databases/$(database)/documents/config/bootstrap)
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == get(/databases/$(database)/documents/config/bootstrap).data.ownerEmail.lower()
        && request.resource.data.keys().hasOnly(['uid', 'since'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'since'])
        && request.resource.data.uid != resource.data.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid));
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Agencies and agents register with business details and start unverified (an admin verifies them).
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['renter', 'agent', 'landlord', 'agency']
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'saved', 'createdAt', 'phone', 'location', 'prefs', 'notify', 'privacy', 'photo', 'agency', 'agentInfo', 'verification'])
        && short(request.resource.data.name, 120)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.saved.size() <= 500
        && (!('verification' in request.resource.data) || (request.resource.data.verification.status == 'pending' && request.resource.data.role in ['agent', 'agency']))
        && (!('agency' in request.resource.data) || request.resource.data.agency.size() <= 20)
        && (!('agentInfo' in request.resource.data) || request.resource.data.agentInfo.size() <= 20);
      // Users edit their own profile but never role, email, ban or verification. The owner can change anything;
      // an admin can ban or unban non-owners and verify agents and agencies, nothing else.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('banned', false) == resource.data.get('banned', false)
          && request.resource.data.get('verified', false) == resource.data.get('verified', false)
          && request.resource.data.get('verification', null) == resource.data.get('verification', null)
          && request.resource.data.get('agency', null) == resource.data.get('agency', null)
          && request.resource.data.get('agentInfo', null) == resource.data.get('agentInfo', null)
          && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'saved', 'createdAt', 'phone', 'location', 'prefs', 'notify', 'privacy', 'photo', 'banned', 'bannedAt', 'verified', 'verification', 'agency', 'agentInfo'])
          && short(request.resource.data.name, 120)
          && request.resource.data.saved.size() <= 500
          && profileOk(request.resource.data))
        || isOwner()
        || (isAdmin() && uid != request.auth.uid
          && ((resource.data.role in ['renter', 'agent', 'landlord', 'agency', 'support']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'bannedAt']))
              || (resource.data.role in ['agent', 'agency']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verification'])))));
      allow delete: if false;
    }

    // One marker per registered email (keyed by a SHA-256 of the email) so sign-in can say "no account found".
    match /accountEmails/{h} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if signedIn() && h.matches('^[0-9a-f]{64}$') && request.resource.data.keys().hasOnly(['t']);
    }


    match /listings/{id} {
      allow read: if resource.data.status == 'active' || isAdmin() || ownsListing();
      // Landlords and agencies add their own listings (held for review) and edit them, but never change their review status.
      allow create: if isAdmin() || (signedIn() && (myRole() == 'landlord' || (myRole() in ['agency', 'agent'] && isVerified()))
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.keys().size() <= 40 && short(request.resource.data.title, 120));
      allow update: if isAdmin() || (ownsListing() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /viewings/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Requested'
        && request.resource.data.keys().size() <= 30
        && short(request.resource.data.title, 200) && short(request.resource.data.name, 200);
      allow read: if owns() || isAdmin() || ownsListing();
      allow update: if isAdmin() || (ownsListing() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Under review'
        && request.resource.data.keys().size() <= 30
        && short(request.resource.data.title, 200) && short(request.resource.data.name, 200);
      allow read: if owns() || isAdmin() || ownsListing();
      allow update: if isAdmin() || (ownsListing() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    match /tickets/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Open'
        && short(request.resource.data.subject, 160) && short(request.resource.data.message, 2000)
        && request.resource.data.keys().size() <= 12;
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if isAdmin() || isSupport();
    }
    // App releases managed from Admin > Installations. Signed-in users can read published ones; only admins write.
    match /appReleases/{id} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'name', 'notes', 'mandatory', 'published', 'files', 'createdAt', 'updatedAt'])
        && short(request.resource.data.version, 20) && short(request.resource.data.name, 120)
        && short(request.resource.data.notes, 4000)
        && request.resource.data.published is bool && request.resource.data.mandatory is bool
        && request.resource.data.files is map && request.resource.data.files.size() <= 20;
      allow delete: if isAdmin();
    }
    // In-app notifications (for example "you have been verified"). Only admins create them; people read and mark their own.
    match /notifications/{id} {
      allow create: if isAdmin() && short(request.resource.data.title, 160) && short(request.resource.data.body, 600)
        && request.resource.data.keys().size() <= 8;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    // Suggestion box on the Contact us page.
    match /suggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && short(request.resource.data.text, 2000) && request.resource.data.text.size() >= 5
        && request.resource.data.keys().size() <= 10;
      allow read, update: if isAdmin() || isSupport();
    }
    match /documents/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && short(request.resource.data.name, 160) && request.resource.data.size < 900000
        && request.resource.data.keys().size() <= 15
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow read, delete: if owns() || isAdmin();
      allow update: if isAdmin();
    }
    match /conversations/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().size() <= 20;
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if (owns() && request.resource.data.uid == resource.data.uid) || isAdmin();
      match /messages/{mid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/conversations/$(id)).data.uid == request.auth.uid || isAdmin());
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && short(request.resource.data.text, 2000)
          && (get(/databases/$(database)/documents/conversations/$(id)).data.uid == request.auth.uid || isAdmin());
      }
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
