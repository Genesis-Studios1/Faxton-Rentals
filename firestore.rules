rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function db() { return /databases/$(database)/documents; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    // The single owner is whoever config/owner points at. Only the owner can transfer it.
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function isAdmin() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'renter') : '';
    }
    function isSupport() { return myRole() == 'support'; }
    function isVerified() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', false) == true;
    }
    function ownsListing() { return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid; }
    function owns() { return signedIn() && resource.data.uid == request.auth.uid; }
    function short(v, n) { return v is string && v.size() <= n; }
    // A booking, application or offer can only point at the real owner of the home it is about (no spamming other people's inboxes).
    function ownerMatchesListing(d) {
      return d.get('listingId', null) is string
        && (exists(/databases/$(database)/documents/listings/$(d.listingId))
          ? d.get('ownerUid', null) == get(/databases/$(database)/documents/listings/$(d.listingId)).data.get('ownerUid', null)
          : d.get('ownerUid', null) == null);
    }
    // Optional profile fields must have the right type and size.
    function profileOk(d) {
      return (!('phone' in d) || short(d.phone, 30))
        && (!('location' in d) || short(d.location, 80))
        && (!('country' in d) || short(d.country, 60))
        && (!('city' in d) || short(d.city, 60))
        && (!('state' in d) || short(d.state, 60))
        && (!('lga' in d) || short(d.lga, 60))
        && (!('photo' in d) || short(d.photo, 70000))
        && (!('prefs' in d) || d.prefs is map)
        && (!('notify' in d) || d.notify is map)
        && (!('privacy' in d) || d.privacy is map)
        && (!('lastActive' in d) || d.lastActive is timestamp)
        && (!('provider' in d) || short(d.provider, 20))
        && (!('emailVerified' in d) || d.emailVerified is bool);
    }

    // Never readable or writable from the app. Set once from the Firebase console: { ownerEmail: "<owner's email>" }
    match /config/bootstrap { allow read, write: if false; }

    // Optional TURN relay for calls: an admin saves it in Settings > Call relay. The call screen of every user needs these details to
    // place a call, so they are readable by signed-in users whose email is verified (not by signed-out visitors or unverified sign-ups).
    // See LAUNCH.md "Call relay" for the trade-off. Only admins and the owner can write.
    match /config/ice {
      allow read: if signedIn() && request.auth.token.email_verified == true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['servers', 'credsUrl', 'updatedAt'])
        && request.resource.data.servers is list && request.resource.data.servers.size() <= 8
        && (!('credsUrl' in request.resource.data) || (request.resource.data.credsUrl is string && request.resource.data.credsUrl.size() <= 400));
    }

    // Bank-transfer details tenants pay into (no payment gateway). Any signed-in user can read; only admins write.
    match /config/payments {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['bankName', 'accountNumber', 'accountName', 'instructions', 'enabled', 'updatedAt', 'updatedBy'])
        && short(request.resource.data.get('bankName', ''), 80) && short(request.resource.data.get('accountNumber', ''), 30)
        && short(request.resource.data.get('accountName', ''), 120) && short(request.resource.data.get('instructions', ''), 1200)
        && request.resource.data.get('enabled', true) is bool;
    }

    // Ownership is claimed once, by the verified email stored in config/bootstrap, then transferable only by the owner.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(ownerDoc())
        && exists(/databases/$(database)/documents/config/bootstrap)
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == get(/databases/$(database)/documents/config/bootstrap).data.ownerEmail.lower()
        && request.resource.data.keys().hasOnly(['uid', 'since'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'since'])
        && request.resource.data.uid != resource.data.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid));
      allow delete: if false;
    }

    // Public profile card: what other people see when they tap a profile picture. Only an admin can set the verified tick.
    match /profiles/{uid} {
      function pubOk(d) {
        return d.keys().hasOnly(['name', 'photo', 'role', 'city', 'country', 'about', 'website', 'verified', 'updatedAt'])
          && short(d.get('name', ''), 120) && short(d.get('about', ''), 300) && short(d.get('website', ''), 160)
          && short(d.get('city', ''), 60) && short(d.get('country', ''), 60) && short(d.get('role', ''), 20)
          && (!('photo' in d) || (d.photo is string && d.photo.size() <= 70000));
      }
      allow read: if signedIn();
      allow create: if signedIn() && pubOk(request.resource.data)
        && ((request.auth.uid == uid && request.resource.data.get('verified', false) == false) || isAdmin());
      allow update: if signedIn() && pubOk(request.resource.data)
        && ((request.auth.uid == uid && request.resource.data.get('verified', false) == resource.data.get('verified', false)) || isAdmin());
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Agencies and agents register with business details and start unverified (an admin verifies them).
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['renter', 'agent', 'landlord', 'agency']
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'saved', 'createdAt', 'phone', 'location', 'prefs', 'notify', 'privacy', 'photo', 'country', 'city', 'state', 'lga', 'agency', 'agentInfo', 'verification'])
        && short(request.resource.data.name, 120)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.saved.size() <= 500 && profileOk(request.resource.data)
        && (!('verification' in request.resource.data) || (request.resource.data.verification.status == 'pending' && request.resource.data.role in ['agent', 'agency']))
        && (!('agency' in request.resource.data) || request.resource.data.agency.size() <= 20)
        && (!('agentInfo' in request.resource.data) || request.resource.data.agentInfo.size() <= 20);
      // Users edit their own profile but never role, email, ban or verification. The owner can change anything;
      // an admin can ban or unban non-owners and verify agents and agencies, nothing else.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('banned', false) == resource.data.get('banned', false)
          && request.resource.data.get('verified', false) == resource.data.get('verified', false)
          && request.resource.data.get('verification', null) == resource.data.get('verification', null)
          && request.resource.data.get('agency', null) == resource.data.get('agency', null)
          && request.resource.data.get('agentInfo', null) == resource.data.get('agentInfo', null)
          && (request.resource.data.get('deletion', null) == resource.data.get('deletion', null)
              || (resource.data.get('deletion', {}).get('status', '') != 'approved'
                  && request.resource.data.get('deletion', {'status': 'pending'}).get('status', '') == 'pending'))
          && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'saved', 'createdAt', 'phone', 'location', 'prefs', 'notify', 'privacy', 'photo', 'banned', 'bannedAt', 'verified', 'verification', 'agency', 'agentInfo', 'deletion', 'country', 'city', 'state', 'lga', 'lastActive', 'provider', 'emailVerified'])
          && (request.resource.data.get('emailVerified', false) == false || request.auth.token.email_verified == true)
          && short(request.resource.data.name, 120)
          && request.resource.data.saved.size() <= 500
          && profileOk(request.resource.data))
        || isOwner()
        || (isAdmin() && uid != request.auth.uid
          && ((resource.data.role in ['renter', 'agent', 'landlord', 'agency', 'support']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'bannedAt']))
              || (resource.data.role in ['agent', 'agency']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verification']))
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletion']))));
      // A person can delete their own profile only after an admin approved the request and a day has passed.
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.get('deletion', {}).get('status', '') == 'approved'
        && request.time.toMillis() >= resource.data.deletion.requestedAt + 86400000;
    }

    // Live "someone signed up / signed in" entries for the team. A person may only record an event about themselves; the app sends a sign-up once
    // (the id is fixed per person, so it cannot be repeated) and a sign-in at most once per 30 minutes. Only admins, the owner and support read them.
    match /staffEvents/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['type', 'uid', 'name', 'role', 'at'])
        && request.resource.data.type in ['signup', 'login']
        && request.resource.data.uid == request.auth.uid
        && short(request.resource.data.name, 120) && short(request.resource.data.role, 20)
        && request.resource.data.at == request.time
        && (request.resource.data.type != 'signup' || id == 'signup_' + request.auth.uid);
      allow read: if isAdmin() || isSupport();
      allow update: if (isAdmin() || isSupport()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if false;
    }

    // "Download my data" records. After a person confirms it's them and downloads their own data (all in their browser), the app files one entry here
    // so staff can see the request was served. It holds no data content. Only the person can create it for themselves; owner, admin and support read it and
    // mark it reviewed (status) or add a note. Nobody deletes.
    match /dataRequests/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'status', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'role', 'status', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'verified-downloaded'
        && short(request.resource.data.name, 120) && short(request.resource.data.role, 20)
        && request.resource.data.role == myRole()
        && request.resource.data.at == request.time;
      allow read: if isAdmin() || isSupport();
      allow update: if (isAdmin() || isSupport())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
        && request.resource.data.status in ['verified-downloaded', 'reviewed']
        && short(request.resource.data.get('note', ''), 1000);
      allow delete: if false;
    }

    // One marker per registered email (keyed by a SHA-256 of the email) so sign-in can say "no account found".
    match /accountEmails/{h} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if signedIn() && h.matches('^[0-9a-f]{64}$') && request.resource.data.keys().hasOnly(['t']);
    }


    match /listings/{id} {
      allow read: if resource.data.status == 'active' || isAdmin() || ownsListing();
      // Landlords and agencies add their own listings (held for review) and edit them, but never change their review status.
      allow create: if isAdmin() || (signedIn() && (myRole() == 'landlord' || (myRole() in ['agency', 'agent'] && isVerified()))
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.keys().size() <= 40 && short(request.resource.data.title, 120));
      allow update: if isAdmin() || (ownsListing() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.keys().size() <= 40 && short(request.resource.data.get('title', ''), 120));
      allow delete: if isAdmin();
    }

    match /viewings/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Requested'
        && ownerMatchesListing(request.resource.data)
        && request.resource.data.keys().size() <= 30
        && short(request.resource.data.title, 200) && short(request.resource.data.name, 200);
      allow read: if owns() || isAdmin() || ownsListing();
      allow update: if isAdmin() || (ownsListing() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Viewing safety: the renter checks in and out, flags an emergency and records who the details were shared with.
        || (owns() && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkIn', 'checkOut', 'sos', 'sharedWith', 'trusted'])
          && (!('trusted' in request.resource.data) || request.resource.data.trusted is map)
          && (!('checkIn' in request.resource.data) || request.resource.data.checkIn is map)
          && (!('checkOut' in request.resource.data) || request.resource.data.checkOut is map)
          && (!('sos' in request.resource.data) || request.resource.data.sos is map)
          && (!('sharedWith' in request.resource.data) || short(request.resource.data.sharedWith, 80)))
        // The renter can cancel a viewing the agent has not confirmed yet, ask to move any live viewing, and rate the agent afterwards.
        || (owns() && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && resource.data.status == 'Requested' && request.resource.data.status == 'Cancelled')
        || (owns() && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reschedule'])
          && resource.data.status in ['Requested', 'Confirmed']
          && request.resource.data.reschedule is map && request.resource.data.reschedule.size() <= 6)
        || (owns() && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
          && !('rating' in resource.data)
          && request.resource.data.rating is map && request.resource.data.rating.size() <= 4
          && request.resource.data.rating.stars is int && request.resource.data.rating.stars >= 1 && request.resource.data.rating.stars <= 5
          && short(request.resource.data.rating.get('text', ''), 400));
    }
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Under review'
        && ownerMatchesListing(request.resource.data)
        && request.resource.data.keys().size() <= 30
        && short(request.resource.data.title, 200) && short(request.resource.data.name, 200);
      allow read: if owns() || isAdmin() || ownsListing();
      // A renter can withdraw an application that is still under review (and only that).
      allow update: if isAdmin() || (ownsListing() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (owns() && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt'])
          && resource.data.status == 'Under review' && request.resource.data.status == 'Withdrawn');
    }

    match /tickets/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Open'
        && short(request.resource.data.subject, 160) && short(request.resource.data.message, 2000)
        && request.resource.data.keys().size() <= 12;
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if isAdmin() || isSupport();
    }
    // Home-service requests (tiling, plumbing, ...) from the /services page. A signed-in user creates their own; the person who made it can
    // read it and cancel it; admins and support read all of them and update the status and a note for the requester.
    match /serviceRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'New'
        && request.resource.data.keys().hasAll(['uid', 'name', 'phone', 'category', 'description', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'area', 'category', 'description', 'preferredDate', 'status', 'createdAt'])
        && short(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && short(request.resource.data.phone, 30) && request.resource.data.phone.size() >= 6
        && short(request.resource.data.get('email', ''), 120) && short(request.resource.data.get('area', ''), 80)
        && short(request.resource.data.category, 60) && request.resource.data.category.size() > 0
        && short(request.resource.data.description, 1500) && request.resource.data.description.size() > 0
        && short(request.resource.data.get('preferredDate', ''), 20);
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if ((isAdmin() || isSupport()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
          && request.resource.data.status in ['New', 'Contacted', 'Scheduled', 'Done', 'Cancelled'] && short(request.resource.data.get('note', ''), 1000))
        || (owns() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'Cancelled');
    }
    // App releases managed from Admin > Installations. Signed-in users can read published ones; only admins write.
    match /appReleases/{id} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'name', 'notes', 'mandatory', 'published', 'files', 'createdAt', 'updatedAt'])
        && short(request.resource.data.version, 20) && short(request.resource.data.name, 120)
        && short(request.resource.data.notes, 4000)
        && request.resource.data.published is bool && request.resource.data.mandatory is bool
        && request.resource.data.files is map && request.resource.data.files.size() <= 20;
      allow delete: if isAdmin();
    }
    // ---- After-rent: the tenant's My Home dashboard ----
    // One record per approved application: lease dates, renewal and move-out requests, and the owner's replies.
    match /tenancies/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/applications/$(id))
        && get(/databases/$(database)/documents/applications/$(id)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/applications/$(id)).data.status in ['Approved', 'Active']
        && request.resource.data.get('ownerUid', null) == get(/databases/$(database)/documents/applications/$(id)).data.get('ownerUid', null)
        && request.resource.data.keys().size() <= 20 && short(request.resource.data.title, 200);
      allow read: if owns() || ownsListing() || isAdmin();
      allow update: if (owns() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renewal', 'moveOut', 'updatedAt']))
        || ((ownsListing() || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'updatedAt']));
    }
    // Maintenance requests. Either side adds one signed entry at a time to the updates list.
    match /maintenance/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Open'
        && request.resource.data.keys().size() <= 16 && short(request.resource.data.title, 140) && short(request.resource.data.desc, 1500)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 400000))
        && request.resource.data.updates is list && request.resource.data.updates.size() == 0;
      allow read: if owns() || ownsListing() || isAdmin();
      allow update: if signedIn() && (owns() || ownsListing() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updates', 'updatedAt'])
        && request.resource.data.updates is list && request.resource.data.updates.size() == resource.data.updates.size() + 1
        && request.resource.data.updates.size() <= 60
        && request.resource.data.updates[request.resource.data.updates.size() - 1].uid == request.auth.uid
        && request.resource.data.status in ['Open', 'In progress', 'Resolved']
        && (owns() || request.resource.data.status != 'Open' || resource.data.status == 'Open');
    }
    // Rent, service charge and utility records for a tenancy. The tenant or the owner can add one; the owner confirms payment.
    match /records/{id} {
      allow create: if signedIn() && request.resource.data.keys().size() <= 14 && short(request.resource.data.label, 120)
        && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount < 1000000000
        && request.resource.data.status in ['Due', 'Paid']
        && exists(/databases/$(database)/documents/tenancies/$(request.resource.data.tenancyId))
        && (request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/tenancies/$(request.resource.data.tenancyId)).data.uid == request.auth.uid
          || (get(/databases/$(database)/documents/tenancies/$(request.resource.data.tenancyId)).data.get('ownerUid', '') == request.auth.uid || isAdmin())
            && get(/databases/$(database)/documents/tenancies/$(request.resource.data.tenancyId)).data.uid == request.resource.data.uid);
      allow read: if owns() || ownsListing() || isAdmin();
      allow update: if (owns() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidOn', 'updatedAt']))
        || ((ownsListing() || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidOn', 'confirmed', 'updatedAt']));
      allow delete: if (owns() && resource.data.get('by', '') == 'tenant') || ownsListing();
    }
    // Property notices from the owner to the tenants of a home.
    match /notices/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.keys().size() <= 10
        && short(request.resource.data.title, 140) && short(request.resource.data.text, 2000)
        && request.resource.data.tenants is list && request.resource.data.tenants.size() <= 300
        && (myRole() in ['landlord', 'agency', 'agent'] || isAdmin());
      allow read: if (signedIn() && request.auth.uid in resource.data.tenants) || ownsListing() || isAdmin();
      allow delete: if ownsListing() || isAdmin();
    }

    // Rent offers and counter-offers. Each change adds exactly one entry to the history, signed by the person making it.
    match /offers/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Pending'
        && ownerMatchesListing(request.resource.data)
        && request.resource.data.keys().size() <= 24 && request.resource.data.amount is int && request.resource.data.listPrice is int
        && request.resource.data.amount > 0 && request.resource.data.amount < request.resource.data.listPrice
        && request.resource.data.amount * 2 >= request.resource.data.listPrice
        && request.resource.data.history is list && request.resource.data.history.size() == 1
        && request.resource.data.history[0].uid == request.auth.uid && request.resource.data.history[0].amount == request.resource.data.amount
        && short(request.resource.data.title, 200) && short(request.resource.data.name, 200);
      allow read: if owns() || ownsListing() || isAdmin();
      allow update: if signedIn() && resource.data.status in ['Pending', 'Countered']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'amount', 'turn', 'history', 'updatedAt'])
        && request.resource.data.history is list && request.resource.data.history.size() == resource.data.history.size() + 1
        && request.resource.data.history[request.resource.data.history.size() - 1].uid == request.auth.uid
        && request.resource.data.amount * 2 >= resource.data.listPrice && request.resource.data.amount <= resource.data.listPrice
        && (request.resource.data.status in ['Accepted', 'Declined', 'Withdrawn'] ? request.resource.data.amount == resource.data.amount : true)
        && (
          // the owner (or an admin, when the home has no owner account) answers a renter's offer
          ((ownsListing() || (resource.data.ownerUid == null && isAdmin())) && resource.data.status == 'Pending'
            && request.resource.data.status in ['Accepted', 'Declined', 'Countered'])
          // the renter answers a counter-offer, or withdraws
          || (owns() && ((resource.data.status == 'Countered' && request.resource.data.status in ['Accepted', 'Pending', 'Withdrawn'])
            || (resource.data.status == 'Pending' && request.resource.data.status == 'Withdrawn')))
        );
    }
    // In-app notifications (for example "you have been verified"). Only admins create them; people read and mark their own.
    match /notifications/{id} {
      allow create: if ((isAdmin() || isSupport()) && short(request.resource.data.title, 160) && short(request.resource.data.body, 600)
        && request.resource.data.keys().size() <= 8)
        // The two sides of a rent offer can notify each other.
        || (signedIn() && request.resource.data.kind == 'offer' && short(request.resource.data.title, 160) && short(request.resource.data.body, 600)
          && request.resource.data.keys().size() <= 9 && request.resource.data.ref is string && request.resource.data.uid is string
          && exists(/databases/$(database)/documents/offers/$(request.resource.data.ref))
          && (get(/databases/$(database)/documents/offers/$(request.resource.data.ref)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/offers/$(request.resource.data.ref)).data.get('ownerUid', '') == request.auth.uid)
          && (request.resource.data.uid == get(/databases/$(database)/documents/offers/$(request.resource.data.ref)).data.uid
            || request.resource.data.uid == get(/databases/$(database)/documents/offers/$(request.resource.data.ref)).data.get('ownerUid', '')));
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    // Ratings and feedback: renters and realtors rate the app, realtors, listings and calls. Staff read, answer and tidy them up.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'rating', 'topic', 'message', 'status', 'createdAt', 'callId', 'peer'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.topic in ['The app', 'Realtors', 'Listings', 'Chat & calls', 'Other']
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && short(request.resource.data.get('message', ''), 1000) && short(request.resource.data.get('name', ''), 120)
        && short(request.resource.data.get('email', ''), 160) && short(request.resource.data.get('role', ''), 20)
        && short(request.resource.data.get('callId', ''), 80) && short(request.resource.data.get('peer', ''), 120);
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if (isAdmin() || isSupport())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt', 'repliedBy'])
        && request.resource.data.status in ['New', 'Answered']
        && short(request.resource.data.get('reply', ''), 1000) && short(request.resource.data.get('repliedBy', ''), 120);
      allow delete: if isAdmin() || isSupport();
    }
    // Suggestion box on the Contact us page.
    match /suggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && short(request.resource.data.text, 2000) && request.resource.data.text.size() >= 5
        && request.resource.data.keys().size() <= 10;
      allow read, update: if isAdmin() || isSupport();
    }
    // Voice and video calls: signalling for WebRTC plus the call log. Calls to "staff" ring every admin and support account.
    match /calls/{id} {
      allow create: if signedIn() && request.resource.data.callerUid == request.auth.uid && request.resource.data.status == 'ringing'
        && request.auth.uid in request.resource.data.members && request.resource.data.keys().size() <= 24
        && (request.resource.data.calleeUid == 'staff' || !exists(/databases/$(database)/documents/blocks/$(request.resource.data.calleeUid + '_' + request.auth.uid)));
      allow read: if signedIn() && (request.auth.uid in resource.data.members || (resource.data.calleeUid == 'staff' && (isAdmin() || isSupport())));
      allow update: if signedIn() && (request.auth.uid in resource.data.members || (resource.data.calleeUid == 'staff' && (isAdmin() || isSupport())))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offer', 'answer', 'answeredAt', 'endedAt', 'duration', 'recCaller', 'recCallee', 'recorded', 'calleeUid', 'members', 'delivered']);
      match /ice/{iid} {
        function party() {
          let c = get(/databases/$(database)/documents/calls/$(id)).data;
          return signedIn() && (request.auth.uid in c.members || (c.calleeUid == 'staff' && (isAdmin() || isSupport())));
        }
        allow read: if party();
        allow create: if party() && request.resource.data.from == request.auth.uid && request.resource.data.keys().size() <= 3;
      }
    }
    // Blocking: one document per pair, named blocker_blocked. The person who blocked can remove it; both can see it.
    match /blocks/{id} {
      allow create: if signedIn() && request.resource.data.blocker == request.auth.uid && request.resource.data.blocked is string
        && id == request.auth.uid + '_' + request.resource.data.blocked && request.resource.data.keys().size() <= 5;
      allow read: if signedIn() && (resource.data.blocker == request.auth.uid || resource.data.blocked == request.auth.uid || isAdmin() || isSupport());
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
    }
    // Reports about other users, reviewed by the Faxton team.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid
        && short(request.resource.data.reason, 80) && short(request.resource.data.details, 2000)
        && request.resource.data.keys().size() <= 12;
      allow read, update: if isAdmin() || isSupport();
    }
    // Bank-transfer proofs: a renter says "I've paid" with an optional receipt image. The owner of the home or an admin confirms or rejects it.
    match /paymentProofs/{id} {
      function proofOwnerOk(d) {
        return d.listingId is string
          && (exists(/databases/$(database)/documents/listings/$(d.listingId))
            ? d.get('ownerUid', null) == get(/databases/$(database)/documents/listings/$(d.listingId)).data.get('ownerUid', null)
            : d.get('ownerUid', null) == null);
      }
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Submitted'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'ownerUid', 'listingId', 'title', 'applicationId', 'forLabel', 'amount', 'reference', 'paidOn', 'note', 'proof', 'proofName', 'status', 'createdAt'])
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 10000000000
        && short(request.resource.data.get('reference', ''), 80) && short(request.resource.data.get('note', ''), 500)
        && short(request.resource.data.get('title', ''), 200) && short(request.resource.data.get('name', ''), 200)
        && short(request.resource.data.get('forLabel', ''), 120) && short(request.resource.data.get('paidOn', ''), 20) && short(request.resource.data.get('proofName', ''), 160)
        && (!('proof' in request.resource.data) || (request.resource.data.proof is string && request.resource.data.proof.size() < 450000))
        && proofOwnerOk(request.resource.data);
      allow read: if owns() || ownsListing() || isAdmin();
      allow update: if (isAdmin() || ownsListing())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt', 'reviewedBy', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['Submitted', 'Confirmed', 'Rejected']
        && short(request.resource.data.get('reviewNote', ''), 400);
    }
    match /documents/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && short(request.resource.data.name, 160) && request.resource.data.size < 900000
        && request.resource.data.keys().size() <= 15
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow read, delete: if owns() || isAdmin();
      allow update: if isAdmin();
    }
    match /conversations/{id} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().size() <= 20) || isAdmin() || isSupport();
      allow read: if owns() || isAdmin() || isSupport();
      allow update: if (owns() && request.resource.data.uid == resource.data.uid) || isAdmin() || isSupport();
      match /messages/{mid} {
        // Emoji reactions: a person may only add, change or remove their own entry in the reactions map.
        allow update: if signedIn()
          && (get(/databases/$(database)/documents/conversations/$(id)).data.uid == request.auth.uid || isAdmin() || isSupport())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map && request.resource.data.reactions.size() <= 30
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions) || (request.resource.data.reactions[request.auth.uid] is string && request.resource.data.reactions[request.auth.uid].size() <= 12));
        allow read: if signedIn() && (get(/databases/$(database)/documents/conversations/$(id)).data.uid == request.auth.uid || isAdmin() || isSupport());
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && short(request.resource.data.text, 2000) && request.resource.data.keys().size() <= 14
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() < 450000))
          && (!('audio' in request.resource.data) || (request.resource.data.audio is string && request.resource.data.audio.size() < 600000))
          && (!('file' in request.resource.data) || (request.resource.data.file is string && request.resource.data.file.size() < 600000))
          && (!('reply' in request.resource.data) || request.resource.data.reply is map)
          && (get(/databases/$(database)/documents/conversations/$(id)).data.uid == request.auth.uid || isAdmin() || isSupport());
      }
    }

    // Presence for the message ticks and "Last seen": a tiny heartbeat document per person, written only by that person.
    // lastSeen must be the server clock. A person can read it when it is theirs, when they are staff, or when they have a
    // staff-started chat with that person (the chat is named <their uid>__dm_<staff uid>, so the rule can check it exists).
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'show', 'lastSeen'])
        && request.resource.data.keys().hasAll(['online', 'lastSeen'])
        && request.resource.data.online is bool && request.resource.data.get('show', true) is bool
        && request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isSupport()
        || exists(/databases/$(database)/documents/conversations/$(request.auth.uid + '__dm_' + uid)));
    }

    // Public website waitlist: visitors may submit a strictly validated entry; only authorised admins may read it.
    function validWebsiteWaitlist(d) {
      return d.keys().hasAll(['name', 'email', 'role', 'city', 'source', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'role', 'city', 'source', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.email is string && d.email.size() >= 6 && d.email.size() <= 120
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ .]+')
        && d.role in ['renter', 'owner', 'agency', 'agent']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.source == 'website'
        && d.createdAt is timestamp
        && d.createdAt <= request.time
        && d.createdAt >= request.time - duration.value(10, 'minutes');
    }
    match /waitlist/{entryId} {
      allow create: if validWebsiteWaitlist(request.resource.data);
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && d.role in ['renter', 'owner', 'agency', 'agent']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.source == 'website'
        && d.createdAt is timestamp
        && d.createdAt <= request.time
        && d.createdAt >= request.time - duration.value(10, 'minutes');
    }
    match /waitlist/{entryId} {
      allow create: if validWebsiteWaitlist(request.resource.data);
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && d.role in ['renter', 'owner', 'agency', 'agent']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.source == 'website'
        && d.createdAt is timestamp
        && d.createdAt <= request.time
        && d.createdAt >= request.time - duration.value(10, 'minutes');
    }
    match /waitlist/{entryId} {
      allow create: if validWebsiteWaitlist(request.resource.data);
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && d.role in ['renter', 'owner', 'agency', 'agent']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.source == 'website'
        && d.createdAt is timestamp
        && d.createdAt <= request.time
        && d.createdAt >= request.time - duration.value(10, 'minutes');
    }
    match /waitlist/{entryId} {
      allow create: if validWebsiteWaitlist(request.resource.data);
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
